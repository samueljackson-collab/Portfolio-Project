# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, good for single-user / local installs):
DATABASE_URL=sqlite+aiosqlite:////app/data/bughunter.db
# PostgreSQL (recommended for multi-user / production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bughunter

# ── Security ──────────────────────────────────────────────────────────────────
# When set, all non-health API endpoints require the X-API-Key header.
# Leave empty to disable auth (useful for local/developer installs).
API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use HTTPS URLs in production (e.g. https://bughunter.example.com).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Limits ────────────────────────────────────────────────────────────────────
# Maximum code_content payload size in bytes (default 1 MB = 1048576).
MAX_CODE_SIZE_BYTES=1048576

# Maximum seconds a scan may run before being marked failed (default 300).
SCAN_TIMEOUT_SECONDS=300

# ── App ───────────────────────────────────────────────────────────────────────
# Set to true to enable Swagger UI (/docs), ReDoc (/redoc), and DEBUG logging.
DEBUG=false
